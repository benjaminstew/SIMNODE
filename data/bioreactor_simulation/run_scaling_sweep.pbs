#!/bin/bash
#PBS -N cnode_scaling_sweep
#PBS -l select=1:ncpus=50:mem=64gb
#PBS -l walltime=10:00:00
#PBS -j oe

source /rds/general/user/bms125/home/miniforge3/etc/profile.d/conda.sh
conda activate cnode

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Unbuffered output so print() lands in the job log in real time.
export PYTHONUNBUFFERED=1

cd /rds/general/user/bms125/home/CNODE
python -m data.bioreactor_simulation.run_scaling_sweep